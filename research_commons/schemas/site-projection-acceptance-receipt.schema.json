{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/site-projection-acceptance-receipt.schema.json",
  "title": "Research Commons Site Projection Acceptance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "packet_id", "destination_repository", "accepted_commit", "decision", "evidence_refs", "runtime_state", "authority_effect"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "destination_repository": {"const": "StegVerse-Labs/Site"},
    "accepted_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision": {"enum": ["ACCEPTED_FOR_PROJECTION", "REJECTED", "REVIEW_REQUIRED"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime_state": {"enum": ["NOT_DEPLOYED", "DEPLOYED_UNVERIFIED", "PUBLIC_PATH_VERIFIED"]},
    "public_paths": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "authority_effect": {"const": "NONE"}
  }
}

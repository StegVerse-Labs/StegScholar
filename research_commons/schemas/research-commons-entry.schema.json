{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/research-commons-entry.schema.json",
  "title": "Research Commons Wiki Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "title",
    "entry_class",
    "knowledge_posture",
    "research_id",
    "artifact_refs",
    "consent",
    "provenance",
    "reuse",
    "status"
  ],
  "properties": {
    "entry_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "entry_class": {
      "enum": [
        "topic",
        "proposal",
        "protocol",
        "source_ledger",
        "dataset_description",
        "dataset",
        "method",
        "compute_manifest",
        "result",
        "negative_result",
        "replication",
        "contradiction",
        "correction",
        "retraction",
        "cost_benchmark"
      ]
    },
    "knowledge_posture": {
      "enum": [
        "witnessed_question",
        "proposal",
        "protocol_candidate",
        "approved_protocol",
        "collected_evidence",
        "computed_result",
        "independently_validated_result",
        "exploratory_finding",
        "moderate_support",
        "strong_support",
        "contradicted",
        "inconclusive",
        "not_identifiable",
        "retracted",
        "superseded"
      ]
    },
    "summary": {"type": "string"},
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_hash", "artifact_type"],
        "properties": {
          "artifact_id": {"type": "string"},
          "artifact_hash": {"type": "string"},
          "artifact_type": {"type": "string"},
          "location": {"type": "string"}
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_id", "consent_hash", "share_with_stegverse", "public_wiki_authorized", "attribution_mode"],
      "properties": {
        "consent_id": {"type": "string"},
        "consent_hash": {"type": "string"},
        "share_with_stegverse": {"const": true},
        "public_wiki_authorized": {"type": "boolean"},
        "attribution_mode": {"enum": ["private", "pseudonymous", "named"]},
        "embargo_until": {"type": ["string", "null"], "format": "date-time"},
        "revocation_policy_ref": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_ref", "created_at", "entry_hash"],
      "properties": {
        "origin_ref": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "entry_hash": {"type": "string"},
        "parent_entry_ids": {"type": "array", "items": {"type": "string"}},
        "supersedes_entry_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reuse_allowed", "license_ref", "requires_admissibility_review"],
      "properties": {
        "reuse_allowed": {"type": "boolean"},
        "license_ref": {"type": "string"},
        "allowed_uses": {"type": "array", "items": {"type": "string"}},
        "excluded_uses": {"type": "array", "items": {"type": "string"}},
        "requires_admissibility_review": {"const": true}
      }
    },
    "disputes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dispute_id", "status", "summary"],
        "properties": {
          "dispute_id": {"type": "string"},
          "status": {"enum": ["open", "resolved", "superseded"]},
          "summary": {"type": "string"},
          "related_entry_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "status": {"enum": ["draft", "admitted", "embargoed", "public", "quarantined", "retracted", "superseded"]}
  }
}

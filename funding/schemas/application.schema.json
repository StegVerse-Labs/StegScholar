{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/funding/application.schema.json",
  "title": "StegScholar Funding Application Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "opportunity",
    "applicant",
    "program",
    "state",
    "authority",
    "dates",
    "evidence_refs",
    "budget",
    "publication_classification",
    "next_action"
  ],
  "properties": {
    "application_id": {"type": "string", "pattern": "^FUNDING-[A-Z0-9-]+$"},
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sponsor", "name", "opportunity_id", "source_url"],
      "properties": {
        "sponsor": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "opportunity_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"}
      }
    },
    "applicant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "principal_contact_role"],
      "properties": {
        "organization": {"const": "StegVerse-Labs"},
        "principal_contact_role": {"type": "string", "minLength": 1}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "research_paths"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 20},
        "research_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "state": {
      "enum": [
        "DISCOVERED",
        "ELIGIBILITY_REVIEW",
        "GO_NO_GO_REVIEW",
        "DRAFTING",
        "INTERNAL_REVIEW",
        "SUBMISSION_READY",
        "SUBMITTED",
        "AWARDED",
        "DECLINED",
        "WITHDRAWN",
        "BLOCKED",
        "SUPERSEDED"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_owner", "ip_authority", "budget_authority", "deliverables_authority"],
      "properties": {
        "application_owner": {"const": "StegVerse-Labs/StegScholar"},
        "ip_authority": {"const": "StegVerse-Labs/StegPatents"},
        "budget_authority": {"const": "StegVerse-Labs/StegFinCo"},
        "deliverables_authority": {"const": "StegVerse-Labs/StegOps-Deliverables"}
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered_at", "deadline"],
      "properties": {
        "discovered_at": {"type": "string", "format": "date-time"},
        "deadline": {"type": "string", "format": "date-time"},
        "submitted_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^/]+/.+|^[A-Za-z0-9_.-]+/.+"}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "requested_amount", "status", "authority_ref"],
      "properties": {
        "currency": {"const": "USD"},
        "requested_amount": {"type": "number", "minimum": 0},
        "status": {"enum": ["NOT_STARTED", "DRAFT", "APPROVED", "BLOCKED"]},
        "authority_ref": {"type": "string", "minLength": 1}
      }
    },
    "publication_classification": {
      "enum": ["PRIVATE", "INTERNAL", "DISCLOSURE_REVIEW_REQUIRED", "PUBLIC_APPROVED"]
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "location", "action", "release_condition"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "release_condition": {"type": "string", "minLength": 1}
      }
    }
  }
}
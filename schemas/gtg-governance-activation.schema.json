{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/gtg-governance-activation.schema.json",
  "title": "GTG Governance Activation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "candidate_transition_id",
    "commit_time",
    "relational_projection",
    "governance_basis",
    "activation_tests",
    "activation_result",
    "activation_justification",
    "authority",
    "continuation"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_id": {"type": "string", "minLength": 1},
    "candidate_transition_id": {"type": "string", "minLength": 1},
    "commit_time": {"type": "string", "format": "date-time"},
    "claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GTG-[A-Z]+-[0-9]{3}$"}
    },
    "relational_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materially_relevant", "participants", "relation_classes", "source_references"],
      "properties": {
        "materially_relevant": {"type": "boolean"},
        "participants": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "relation_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "RESPONSIBILITY",
              "AUTHORITY",
              "CONSTRAINT",
              "CONSEQUENCE",
              "EVIDENCE",
              "DEPENDENCY",
              "CONSENT",
              "STANDING",
              "CUSTODY",
              "DELEGATION",
              "VULNERABILITY",
              "COUPLED_RISK",
              "SHARED_RESOURCE",
              "CONTINUATION_RIGHT",
              "CHALLENGE_RIGHT",
              "OTHER"
            ]
          }
        },
        "source_references": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "governance_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "policy_refs", "authority_refs", "constraint_refs", "evidence_refs"],
      "properties": {
        "applicable": {"type": "boolean"},
        "policy_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "constraint_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "consent_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "standing_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "continuation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "activation_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discoverable", "commit_reconstructable", "basis_attached", "included_in_admissibility", "outcome_sensitive"],
      "properties": {
        "discoverable": {"type": "boolean"},
        "commit_reconstructable": {"type": "boolean"},
        "basis_attached": {"type": "boolean"},
        "included_in_admissibility": {"type": "boolean"},
        "outcome_sensitive": {"type": "boolean"}
      }
    },
    "activation_result": {
      "enum": ["ACTIVE", "INACTIVE", "INCOMPLETE", "NOT_APPLICABLE", "ERROR"]
    },
    "activation_justification": {"type": "string", "minLength": 1},
    "missing_requirements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer_standing", "review_standing", "execution_authority", "certification_authority"],
      "properties": {
        "observer_standing": {"type": "boolean"},
        "review_standing": {"type": "boolean"},
        "execution_authority": {"type": "boolean"},
        "transformation_authority": {"type": "boolean"},
        "certification_authority": {"type": "boolean"},
        "publication_authority": {"type": "boolean"}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["survives_actor_termination", "reconstruction_refs", "challenge_refs", "supersession_refs"],
      "properties": {
        "survives_actor_termination": {"type": "boolean"},
        "reconstruction_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "challenge_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "supersession_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"activation_result": {"const": "ACTIVE"}}, "required": ["activation_result"]},
      "then": {
        "properties": {
          "relational_projection": {"properties": {"materially_relevant": {"const": true}}},
          "governance_basis": {"properties": {"applicable": {"const": true}}},
          "activation_tests": {
            "properties": {
              "discoverable": {"const": true},
              "commit_reconstructable": {"const": true},
              "basis_attached": {"const": true},
              "included_in_admissibility": {"const": true},
              "outcome_sensitive": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"activation_result": {"const": "NOT_APPLICABLE"}}, "required": ["activation_result"]},
      "then": {
        "properties": {
          "relational_projection": {"properties": {"materially_relevant": {"const": false}}},
          "activation_tests": {"properties": {"outcome_sensitive": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"activation_result": {"const": "INCOMPLETE"}}, "required": ["activation_result"]},
      "then": {"required": ["missing_requirements"], "properties": {"missing_requirements": {"minItems": 1}}}
    }
  ]
}
